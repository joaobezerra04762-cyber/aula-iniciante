css:

*{
margin: 0;
padding: 0;
box-sizing:border-box
}

.game-board{
width: 80%;
height: 500px;
border: 1px solid black;
position:relative;
margin: 0 auto;
overflow: hidden;
}


.pipe{
    position: absolute;
    bottom: 0;
    width: 80px;
    animation: pipe-animation 2s infinite linear;

}

@keyframes pipe-animation {
    from {
        right: -80px;

    }
    to{
        right:100%
    }
}
